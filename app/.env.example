VITE_LIVE_API_BASE_URL=http://localhost:8000
VITE_MCP_BASE_URL=http://localhost:8050
VITE_SUPPORTS_AGENT_TOOLS=false
VITE_SUPPORTS_EDIT_RECORDS=true
VITE_SUPPORTS_ASK_PATRA=false
VITE_SUPPORTS_MCP_EXPLORER=false
VITE_SUPPORTS_DOMAIN_EXPERIMENTS=false
VITE_SUPPORTS_DEV_OPEN_ACCESS=false
VITE_SUPPORTS_HF_IMPORT=true
VITE_EMBEDDED_AUTH_ENABLED=false
VITE_PORTAL_AUTH_ORIGINS=
VITE_PORTAL_AUTH_TIMEOUT_MS=3000
# Standalone login mode: "password" (current ROPC form, default) or
# "redirect" (browser redirect to Tapis's hosted login page).
VITE_STANDALONE_AUTH_MODE=password
VITE_TAPIS_TENANT_BASE_URL=https://icicleai.tapis.io
# Client ID from the self-service Tapis OAuth2 client registered for this
# deployment's exact origin. Not secret -- safe to ship in the bundle.
VITE_TAPIS_CLIENT_ID=
